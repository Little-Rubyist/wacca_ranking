# encoding: utf-8
create_table "songs", force: :cascade, charset: "utf8mb4", collation: "utf8mb4_0900_ai_ci" do |t|
  t.string :title
  t.string :title_english
  t.string :ruby
  t.integer :music_id
  t.boolean :can_play_offline
  t.integer :genre
  t.integer :diff_type
  t.float :difficulty
  t.datetime "updated_at", precision: 6, null: false
  t.datetime "created_at", precision: 6, null: false
end
